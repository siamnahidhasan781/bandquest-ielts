# BandQuest IELTS — Environment configuration
# Copy to .env.local and fill in your values. Never commit real secrets.

# --- Gemini AI (server-side only; never expose to the browser) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names are configurable without code changes:
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_AUDIO_MODEL=gemini-3.8-flash

# --- Database ---
# SQLite file path (created automatically on first run)
DATABASE_URL=./data/bandquest.db

# --- Auth ---
# Random 32+ character secret for session JWTs. Generate: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-in-production

# --- Google sign-in (optional; email+password works without it) ---
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth client ID" (type: Web application)
# 3. Add Authorized redirect URI: <PUBLIC_APP_URL>/api/auth/google/callback
#    (e.g. https://your-domain.com/api/auth/google/callback)
# 4. Paste the client ID + secret below and restart the app.
# Until these are set, the "Continue with Google" button stays hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
